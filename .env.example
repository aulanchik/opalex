OPENALEX_API_KEY=

# Server
PORT=3000
NODE_ENV=development

OPENALEX_API=https://api.openalex.org
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=3

# Local rate limiter (defaults shown)
RATE_LIMIT_CAPACITY=50
RATE_LIMIT_REFILL_RATE=50

# Cache: "memory" (default) or "redis"
CACHE_DRIVER=memory
CACHE_TTL_SECONDS=3600
# Maximum entries for the memory driver
CACHE_MAX_ENTRIES=500

# Redis driver. REDIS_URL is required when CACHE_DRIVER=redis (use rediss:// for TLS).
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=openalex-proxy:cache:
# REDIS_COMMAND_TIMEOUT_MS=500
